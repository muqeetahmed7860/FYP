generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                 @id @default(cuid())
  email         String                 @unique
  phone         String?
  passwordHash  String
  role          String                 @default("USER")
  status        String                 @default("ACTIVE")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  profile       Profile?
  sessions      Session[]
  accounts      FinancialAccount[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         FinancialGoal[]
  recurring     RecurringObligation[]
  assets        Asset[]
  liabilities   Liability[]
  incomeSources IncomeSource[]
  withholding   WithholdingTaxRecord[]
  taxProfiles   TaxProfile[]
  calculations  TaxCalculation[]
  wealth        WealthStatement[]
  reports       GeneratedReport[]
  notifications Notification[]
  audit         AuditLog[]
  experience    UserExperience?
  trash         DeletedRecord[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  device    String   @default("Browser")

  @@index([userId])
}

model Profile {
  id                       String  @id @default(cuid())
  userId                   String  @unique
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  cnic                     String  @default("")
  occupation               String  @default("")
  taxpayerType             String  @default("SALARIED")
  residentialStatus        String  @default("RESIDENT")
  preferredCurrency        String  @default("PKR")
  monthlyIncomeEstimate    Decimal @default(0) @db.Decimal(20, 2)
  primaryIncomeType        String  @default("Salary")
  taxRegistrationStatus    String  @default("UNREGISTERED")
  ntn                      String  @default("")
  dependents               Int     @default(0)
  emergencySavings         Decimal @default(0) @db.Decimal(20, 2)
  essentialMonthlyExpenses Decimal @default(0) @db.Decimal(20, 2)
  incomeStability          String  @default("STABLE")
}

model FinancialAccount {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  accountName    String
  accountType    String
  openingBalance Decimal       @db.Decimal(20, 2)
  openingDate    DateTime      @db.Date
  institution    String        @default("")
  currency       String        @default("PKR")
  active         Boolean       @default(true)
  entries        LedgerEntry[]
  transactions   Transaction[]

  @@index([userId])
}

model TransactionCategory {
  id           String           @id @default(cuid())
  name         String
  type         String
  essential    Boolean          @default(false)
  transactions Transaction[]
  budgets      BudgetCategory[]

  @@unique([name, type])
}

model Transaction {
  id                   String               @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id])
  accountId            String
  account              FinancialAccount     @relation(fields: [accountId], references: [id])
  destinationAccountId String?
  type                 String
  amount               Decimal              @db.Decimal(20, 2)
  date                 DateTime             @db.Date
  categoryId           String?
  category             TransactionCategory? @relation(fields: [categoryId], references: [id])
  subcategory          String               @default("")
  merchant             String               @default("")
  description          String               @default("")
  paymentMethod        String               @default("BANK")
  person               String               @default("")
  taxRelevant          Boolean              @default(false)
  businessOrPersonal   String               @default("PERSONAL")
  recurring            Boolean              @default(false)
  source               String               @default("MANUAL")
  idempotencyKey       String
  revision             Int                  @default(1)
  createdAt            DateTime             @default(now())
  entries              LedgerEntry[]

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
}

model LedgerEntry {
  id            String           @id @default(cuid())
  transactionId String
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       FinancialAccount @relation(fields: [accountId], references: [id])
  amount        Decimal          @db.Decimal(20, 2)

  @@unique([transactionId, accountId])
}

model Budget {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  name           String
  period         String
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  amount         Decimal          @db.Decimal(20, 2)
  alertThreshold Int              @default(75)
  savingsTarget  Decimal          @default(0) @db.Decimal(20, 2)
  categories     BudgetCategory[]

  @@index([userId])
}

model BudgetCategory {
  budgetId   String
  budget     Budget              @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String
  category   TransactionCategory @relation(fields: [categoryId], references: [id])

  @@id([budgetId, categoryId])
}

model FinancialGoal {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id])
  name                String
  goalType            String           @default("CUSTOM")
  targetAmount        Decimal          @db.Decimal(20, 2)
  currentAmount       Decimal          @default(0) @db.Decimal(20, 2)
  targetDate          DateTime         @db.Date
  priority            Int              @default(3)
  minimumContribution Decimal          @default(0) @db.Decimal(20, 2)
  status              String           @default("ACTIVE")
  allocations         GoalAllocation[]

  @@index([userId])
}

model GoalAllocation {
  id          String        @id @default(cuid())
  goalId      String
  goal        FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(20, 2)
  explanation String
  batchId     String
  createdAt   DateTime      @default(now())

  @@unique([goalId, batchId])
}

model RecurringObligation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  merchant     String
  category     String
  amount       Decimal  @db.Decimal(20, 2)
  intervalDays Int
  nextDueDate  DateTime @db.Date
  confidence   Int
  status       String   @default("POSSIBLE")
  fingerprint  String

  @@unique([userId, fingerprint])
}

model Asset {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  description          String
  assetType            String
  acquisitionDate      DateTime @db.Date
  acquisitionCost      Decimal  @db.Decimal(20, 2)
  currentDeclaredValue Decimal  @db.Decimal(20, 2)
  sourceOfFunds        String
  ownershipPercentage  Decimal  @default(100) @db.Decimal(5, 2)

  @@index([userId])
}

model Liability {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  description       String
  liabilityType     String
  originalAmount    Decimal   @db.Decimal(20, 2)
  outstandingAmount Decimal   @db.Decimal(20, 2)
  monthlyPayment    Decimal   @default(0) @db.Decimal(20, 2)
  lender            String
  startDate         DateTime  @db.Date
  endDate           DateTime? @db.Date

  @@index([userId])
}

model IncomeSource {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  name       String
  incomeType String
}

model WithholdingTaxRecord {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  taxYear              Int
  date                 DateTime @db.Date
  amount               Decimal  @db.Decimal(20, 2)
  section              String
  nature               String
  payer                String
  certificateReference String
  taxTreatment         String   @default("REVIEW_REQUIRED")

  @@index([userId, taxYear])
}

model TaxProfile {
  id                        String  @id @default(cuid())
  userId                    String
  user                      User    @relation(fields: [userId], references: [id])
  taxYear                   Int
  openingWealth             Decimal @db.Decimal(20, 2)
  otherInflows              Decimal @default(0) @db.Decimal(20, 2)
  otherOutflows             Decimal @default(0) @db.Decimal(20, 2)
  adjustmentsExplanation    String  @default("")
  assetsReviewed            Boolean @default(false)
  liabilitiesReviewed       Boolean @default(false)
  withholdingReviewed       Boolean @default(false)
  ordinaryResidentConfirmed Boolean @default(false)
  openingWealthConfirmed    Boolean @default(false)
  expensesReviewed          Boolean @default(false)

  @@unique([userId, taxYear])
}

model TaxYear {
  year        Int       @id
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  status      String    @default("DRAFT")
  ruleVersion Int       @default(1)
  rules       TaxRule[]
}

model TaxRule {
  id            String             @id @default(cuid())
  ruleCode      String
  taxYear       Int
  year          TaxYear            @relation(fields: [taxYear], references: [year])
  version       Int
  name          String
  description   String
  taxpayerType  String             @default("ALL")
  incomeHead    String             @default("ALL")
  section       String
  schedule      String
  division      String
  clause        String             @default("")
  effectiveFrom DateTime           @db.Date
  effectiveTo   DateTime           @db.Date
  priority      Int                @default(0)
  ruleType      String
  formulaType   String
  active        Boolean            @default(true)
  verified      Boolean            @default(false)
  published     Boolean            @default(false)
  notes         String             @default("")
  parameters    Json
  slabs         TaxSlab[]
  conditions    TaxRuleCondition[]
  references    TaxRuleReference[]

  @@unique([taxYear, version, ruleCode])
}

model TaxSlab {
  id         String   @id @default(cuid())
  ruleId     String
  rule       TaxRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  lowerBound Decimal  @db.Decimal(20, 2)
  upperBound Decimal? @db.Decimal(20, 2)
  baseTax    Decimal  @db.Decimal(20, 2)
  rate       Decimal  @db.Decimal(12, 8)
  excessOver Decimal  @db.Decimal(20, 2)
  sequence   Int

  @@unique([ruleId, sequence])
}

model TaxRuleCondition {
  id       String  @id @default(cuid())
  ruleId   String
  rule     TaxRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  field    String
  operator String
  value    String
}

model TaxRuleReference {
  id             String    @id @default(cuid())
  ruleId         String
  rule           TaxRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sourceDocument String
  url            String
  page           String
  verifiedAt     DateTime?
}

model TaxCalculation {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  taxYear     Int
  ruleVersion Int
  status      String               @default("DRAFT")
  inputHash   String
  dataset     Json
  result      Json
  createdAt   DateTime             @default(now())
  finalizedAt DateTime?
  steps       TaxCalculationStep[]

  @@index([userId, taxYear])
}

model TaxCalculationStep {
  id            String         @id @default(cuid())
  calculationId String
  calculation   TaxCalculation @relation(fields: [calculationId], references: [id])
  sequence      Int
  stepName      String
  detail        Json
}

model WealthStatement {
  id               String                     @id @default(cuid())
  userId           String
  user             User                       @relation(fields: [userId], references: [id])
  taxYear          Int
  asOf             DateTime
  totalAssets      Decimal                    @db.Decimal(20, 2)
  totalLiabilities Decimal                    @db.Decimal(20, 2)
  netWealth        Decimal                    @db.Decimal(20, 2)
  createdAt        DateTime                   @default(now())
  assets           WealthStatementAsset[]
  liabilities      WealthStatementLiability[]
  reconciliations  WealthReconciliation[]
}

model WealthStatementAsset {
  id          String          @id @default(cuid())
  statementId String
  statement   WealthStatement @relation(fields: [statementId], references: [id])
  description String
  value       Decimal         @db.Decimal(20, 2)
}

model WealthStatementLiability {
  id          String          @id @default(cuid())
  statementId String
  statement   WealthStatement @relation(fields: [statementId], references: [id])
  description String
  value       Decimal         @db.Decimal(20, 2)
}

model WealthReconciliation {
  id              String          @id @default(cuid())
  statementId     String
  statement       WealthStatement @relation(fields: [statementId], references: [id])
  openingWealth   Decimal         @db.Decimal(20, 2)
  expectedClosing Decimal         @db.Decimal(20, 2)
  difference      Decimal         @db.Decimal(20, 2)
  explanation     Json
  createdAt       DateTime        @default(now())
}

model GeneratedReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  snapshot  Json
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  details   Json?

  @@index([userId, createdAt])
}

model SystemSetting {
  key   String @id
  value Json
}

model UserExperience {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Json     @default("{}")
  city        String   @default("")
  photo       Bytes?
  updatedAt   DateTime @updatedAt
}

model DeletedRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource  String
  snapshot  Json
  expiresAt DateTime
  @@index([userId, expiresAt])
}

model RuleHistory {
  id        String   @id @default(cuid())
  ruleCode  String
  taxYear   Int
  version   Int
  actorId   String
  action    String
  reason    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  @@index([taxYear, version, ruleCode])
}

model AppContent {
  id        String   @id @default(cuid())
  kind      String
  title     String
  body      String
  segment   String   @default("ALL")
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model SystemError {
  id        String   @id @default(cuid())
  code      String
  path      String
  createdAt DateTime @default(now())
}

model UsabilityEvent {
  id         String   @id @default(cuid())
  name       String
  durationMs Int?
  clicks     Int?
  createdAt  DateTime @default(now())
}
