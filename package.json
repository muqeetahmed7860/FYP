{
  "name": "hisabketab-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/start.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node app.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "powershell -ExecutionPolicy Bypass -File scripts/local-db.ps1",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed.ts --demo",
    "admin": "tsx scripts/promote-admin.ts",
    "postinstall": "prisma generate",
    "db:initialize": "tsx scripts/initialize-database.ts",
    "build:hostinger": "prisma generate && prisma migrate deploy && npm run db:initialize && npm run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.20.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7",
    "prisma": "6.19.3",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.14.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "24.x"
  },
  "main": "app.cjs"
}
